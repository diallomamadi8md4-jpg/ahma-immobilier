# Signature des sessions (≥ 32 caractères)
JWT_SECRET="remplacez-par-une-chaine-aleatoire-longue"

# URL publique du site (sitemap, Open Graph, liens dans les emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Envoi d'emails facultatif (alertes de recherche)
RESEND_API_KEY=""
