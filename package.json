{
  "name": "ahma-immobilier",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "build:cloud": "prisma generate --schema prisma/schema.cloud.prisma && next build",
    "db:cloud:push": "prisma db push --schema prisma/schema.cloud.prisma",
    "db:cloud:seed": "tsx prisma/seed.ts",
    "db:cloud:init": "npm run db:cloud:push && npm run db:cloud:seed",
    "admin:password": "tsx scripts/set-admin-password.ts",
    "start:cloud": "HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "jose": "^5.6.3",
    "lucide-react": "^0.424.0",
    "next": "14.2.5",
    "pdfkit": "^0.14.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.4.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.15",
    "@types/pdfkit": "^0.13.4",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "^8.4.40",
    "prisma": "^5.18.0",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
}
